# Google Firebase 설정
# 로컬 개발 시 이 파일을 복사하여 .env.local 로 저장한 후 본인의 값을 입력하세요.
# GitHub Pages 배포 시에는 GitHub 레포지토리 Settings > Secrets and variables > Actions 에 아래 3개 변수를 등록하세요.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=postech-graduation-sim
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef
